{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rexyll.github.io/robot_knowledgebasement/schemas/staubli-lifecycle-traceability.schema.json",
  "title": "Stäubli SocketV2 Lifecycle Traceability Manifest",
  "description": "Machine-checkable design-time traceability contract. Schema validation does not prove runtime safety or test execution. Each resource_key + ownership_phase group must resolve to one logical owner and one reconcile coordinator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "upstream_baseline",
    "audit_source",
    "reference_catalog",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "const": "staubli_socket_v2_lifecycle"
    },
    "upstream_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "ICube-Robotics/staubli_driver_ros2"
        },
        "commit": {
          "const": "bd658e2d266e315d2ee35f985fb352ea88306b79"
        }
      }
    },
    "audit_source": {
      "type": "string",
      "minLength": 1
    },
    "reference_catalog": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(RACE-[0-9]{2}|EXEC-[0-9]{2})$"
      }
    },
    "records": {
      "type": "array",
      "minItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "resource",
          "resource_owner",
          "reconcile_coordinator",
          "failure_states",
          "required_evidence",
          "evidence",
          "status",
          "test_refs",
          "resource_key",
          "ownership_phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(F(0[1-9]|1[0-6])|PLUG-L(0[1-9]|1[0-2]))$"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "resource_owner": {
            "type": "string",
            "minLength": 1,
            "description": "Exactly one logical strong owner role for this resource/generation."
          },
          "reconcile_coordinator": {
            "type": "string",
            "minLength": 1,
            "description": "Exactly one serialized reconcile executor role; may differ from resource owner."
          },
          "failure_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "design_spec",
                "source_review",
                "test_log",
                "environment_manifest",
                "artifact_hash",
                "hardware_acceptance"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "state",
                "uri"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "design_spec",
                    "source_review",
                    "test_log",
                    "environment_manifest",
                    "artifact_hash",
                    "hardware_acceptance"
                  ]
                },
                "state": {
                  "enum": [
                    "PRESENT",
                    "MISSING",
                    "NOT_RUN"
                  ]
                },
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "enum": [
              "SPECIFIED",
              "STATIC_REVIEWED",
              "DESIGN_REVIEWED",
              "RUN_PASS",
              "RUN_FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "test_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(RACE-[0-9]{2}|EXEC-[0-9]{2})$"
            }
          },
          "blocker": {
            "type": "string"
          },
          "resource_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "minLength": 1
          },
          "ownership_phase": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RESIDUAL_TRANSFERRED",
              "PROCESS_RETAINED"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "BLOCKED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "blocker"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_RUN"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "items": {
                    "properties": {
                      "state": {
                        "enum": [
                          "NOT_RUN",
                          "PRESENT"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}

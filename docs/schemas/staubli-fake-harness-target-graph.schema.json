{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/staubli-fake-harness-target-graph.schema.json",
  "title": "Stäubli Fake Harness normalized CMake target graph snapshot",
  "type": "object",
  "required": ["schema_version", "configuration_id", "build_testing", "targets", "install_entries", "exported_targets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "configuration_id": {"type": "string", "minLength": 1},
    "build_testing": {"type": "boolean"},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "dependencies"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "type": {"type": "string"},
          "include_directories": {"type": "array", "items": {"type": "string"}},
          "compile_definitions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "install_entries": {"type": "array", "items": {"type": "string"}},
    "exported_targets": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
